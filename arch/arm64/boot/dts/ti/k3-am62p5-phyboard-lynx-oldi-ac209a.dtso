/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "k3-pinctrl.h"

&{/} {
	display {
		compatible = "powertip,ph128800t006-zhc01";
		backlight = <&backlight>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;
			port@0 {
				reg = <0>;
				lcd_in0: endpoint {
					remote-endpoint = <&oldi0_dss0_out>;
				};
			};
		};
	};

	backlight: backlight {
		pinctrl-names = "default";
		pinctrl-0 = <&bl_pwm_pins_default>;

		compatible = "pwm-backlight";

		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <6>;

		enable-gpios = <&main_gpio0 15 GPIO_ACTIVE_HIGH>;
		pwms = <&epwm0 1 50000 0>;
	};
};

&main_pmx0 {
	bl_pwm_pins_default: bl-pwm-default-pins {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x01b8, PIN_INPUT, 2) /* (E20) SPI0_CS1.EHRPWM0_B */
			AM62PX_IOPAD(0x003c, PIN_INPUT, 7) /* (U22) GPMC0_AD0.GPIO0_15 */
		>;
	};

	touch_screen_pins_default: touch-screen-default-pins {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x0048, PIN_OUTPUT, 7) /* (V25) GPMC0_AD3.GPIO0_18 - RST */
			AM62PX_IOPAD(0x004c, PIN_INPUT, 7) /* (T20) GPMC0_AD4.GPIO0_19 - INT */
		>;
	};

	main_oldi0_pins_default: main-oldi0-default-pins {
		pinctrl-single,pins = <
			AM62PX_IOPAD(0x0260, PIN_OUTPUT, 0) /* (AE20) OLDI0_A0N */
			AM62PX_IOPAD(0x025c, PIN_OUTPUT, 0) /* (AD20) OLDI0_A0P */
			AM62PX_IOPAD(0x0268, PIN_OUTPUT, 0) /* (AC19) OLDI0_A1N */
			AM62PX_IOPAD(0x0264, PIN_OUTPUT, 0) /* (AD19) OLDI0_A1P */
			AM62PX_IOPAD(0x0270, PIN_OUTPUT, 0) /* (AA19) OLDI0_A2N */
			AM62PX_IOPAD(0x026c, PIN_OUTPUT, 0) /* (AB19) OLDI0_A2P */
			AM62PX_IOPAD(0x0278, PIN_OUTPUT, 0) /* (AD18) OLDI0_A3N */
			AM62PX_IOPAD(0x0274, PIN_OUTPUT, 0) /* (AD19) OLDI0_A3P */
			AM62PX_IOPAD(0x02a0, PIN_OUTPUT, 0) /* (AE18) OLDI0_CLK0N */
			AM62PX_IOPAD(0x029c, PIN_OUTPUT, 0) /* (AE17) OLDI0_CLK0P */
		>;
	};
};

&epwm0 {
	status = "okay";
};

&dss0 {
	pinctrl-names = "default";
	pinctrl-0 = <&main_oldi0_pins_default>;
	status = "okay";
};

&dss0_ports {
	#address-cells = <1>;
	#size-cells = <0>;

	/* VP1: LVDS Output */
	port@0 {
		reg = <0>;
		#address-cells = <1>;
		#size-cells = <0>;

		dss0_out0: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&oldi0_dss0_in>;
		};
	};
};

&main_i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	touchscreen@41 {
		compatible = "ilitek,ili2132";
		reg = <0x41>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_screen_pins_default>;

		interrupt-parent = <&main_gpio0>;
		interrupts = <19 IRQ_TYPE_EDGE_FALLING>;

		reset-gpios = <&main_gpio0 18 GPIO_ACTIVE_LOW>;
		irq-gpios = <&main_gpio0 19 GPIO_ACTIVE_HIGH>;
	};
};

&oldi0_dss0 {
	ti,oldi-io-ctrl = <&dss_oldi_io_ctrl>;
	status = "okay";
};

&oldi0_dss0_port0 {
	oldi0_dss0_in: endpoint {
		remote-endpoint = <&dss0_out0>;
	};
};

&oldi0_dss0_port1 {
	oldi0_dss0_out: endpoint {
		remote-endpoint = <&lcd_in0>;
	};
};
